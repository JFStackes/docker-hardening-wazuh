# Wazuh Manager reachable from the monitored server.
WAZUH_MANAGER=CHANGE_ME_MANAGER_IP_OR_DNS

# Normally the same address as WAZUH_MANAGER for a single-node deployment.
WAZUH_REGISTRATION_SERVER=CHANGE_ME_MANAGER_IP_OR_DNS

# Optional. Leave empty when enrollment does not require a password.
WAZUH_REGISTRATION_PASSWORD=

# Agent package must not be newer than the manager.
WAZUH_AGENT_VERSION=4.14.7-1
