# JFStack - Wazuh 4.14.7 bootstrap environment
#
# These are Wazuh's known bootstrap credentials, not private deployment
# secrets. `make init` copies this file to local `.env` mode 0600.
# Rotate credentials after the first successful startup and before exposure.
#
# IMPORTANT: changing only .env does NOT rotate credentials inside Wazuh.

WAZUH_INDEXER_ADMIN_USER=admin
WAZUH_INDEXER_ADMIN_PASSWORD=SecretPassword

WAZUH_DASHBOARD_INDEXER_USER=kibanaserver
WAZUH_DASHBOARD_INDEXER_PASSWORD=kibanaserver

WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-

WAZUH_DASHBOARD_BIND_IP=127.0.0.1
WAZUH_DASHBOARD_PORT=443

WAZUH_AGENT_BIND_IP=0.0.0.0
WAZUH_ENROLLMENT_BIND_IP=0.0.0.0
WAZUH_SYSLOG_BIND_IP=0.0.0.0

OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
